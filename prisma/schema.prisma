generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  role          Role      @default(CREATOR)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  workspaces    WorkspaceMember[]
}

enum Role {
  ADMIN
  CREATOR
  VIEWER
}

model Workspace {
  id            String    @id @default(cuid())
  name          String
  ownerId       String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  members           WorkspaceMember[]
  socialConnections SocialConnection[]
  mediaAssets       MediaAsset[]
  promptConfigs     PromptConfig[]
  posts             Post[]
  aiUsageLogs       AIUsageLog[]
}

enum WorkspaceRole {
  ADMIN
  MEMBER
  VIEWER
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  userId      String
  workspaceId String
  role        WorkspaceRole @default(MEMBER)
  user        User          @relation(fields: [userId], references: [id])
  workspace   Workspace     @relation(fields: [workspaceId], references: [id])
  joinedAt    DateTime      @default(now())

  @@unique([userId, workspaceId])
}

model SocialConnection {
  id            String    @id @default(cuid())
  workspaceId   String
  platform      Platform
  accountId     String    // The ID of the page/account on the platform
  accountName   String
  accessToken   String
  refreshToken  String?
  tokenExpiresAt DateTime?
  isActive      Boolean   @default(true)
  workspace     Workspace @relation(fields: [workspaceId], references: [id])
  postTargets   PostTarget[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum Platform {
  FACEBOOK
  INSTAGRAM
  TWITTER
  LINKEDIN
  LINE
  TIKTOK
}

model MediaAsset {
  id          String    @id @default(cuid())
  workspaceId String
  fileName    String
  fileUrl     String
  fileType    MediaType
  status      AssetStatus @default(PENDING)
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  posts       PostMedia[]
  createdAt   DateTime  @default(now())
}

enum MediaType {
  IMAGE
  VIDEO
}

enum AssetStatus {
  PENDING
  APPROVED
  REJECTED
}

model PromptConfig {
  id          String    @id @default(cuid())
  workspaceId String
  provider    AIProvider
  apiKey      String
  isActive    Boolean   @default(true)
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum AIProvider {
  OPENROUTER
  OPENAI
  CLAUDE
  GEMINI
}

model Post {
  id             String    @id @default(cuid())
  workspaceId    String
  content        String
  status         PostStatus @default(DRAFT)
  scheduledTime  DateTime?
  publishedTime  DateTime?
  errorMessage   String?
  workspace      Workspace @relation(fields: [workspaceId], references: [id])
  media          PostMedia[]
  targets        PostTarget[]
  isDeleted      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

enum PostStatus {
  DRAFT
  WAITING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

model PostMedia {
  id           String     @id @default(cuid())
  postId       String
  mediaAssetId String
  post         Post       @relation(fields: [postId], references: [id])
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id])

  @@unique([postId, mediaAssetId])
}

model PostTarget {
  id                 String           @id @default(cuid())
  postId             String
  socialConnectionId String
  externalPostId     String?          // The ID from the social platform if successful
  status             PostStatus       @default(DRAFT)
  errorMessage       String?
  
  // Insights & Analytics
  reach              Int              @default(0)
  engagement         Int              @default(0)
  impressions        Int              @default(0)
  clicks             Int              @default(0)
  insightsSyncedAt   DateTime?

  post               Post             @relation(fields: [postId], references: [id])
  socialConnection   SocialConnection @relation(fields: [socialConnectionId], references: [id])

  @@unique([postId, socialConnectionId])
}

model AIUsageLog {
  id               String      @id @default(cuid())
  workspaceId      String
  actionType       String      // "ARTICLE" | "IMAGE" | "VIDEO"
  provider         String      // "GEMINI" | "OPENAI" | "FREE"
  modelName        String?
  promptTokens     Int         @default(0)
  completionTokens Int         @default(0)
  totalTokens      Int         @default(0)
  estimatedCost    Float       @default(0.0) // Cost in USD
  workspace        Workspace   @relation(fields: [workspaceId], references: [id])
  createdAt        DateTime    @default(now())
}

