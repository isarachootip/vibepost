# Copy to .env (local) or set in Coolify (production). Never commit real values.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/contentdb"

# NextAuth secret — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Shared secret for /api/cron/publisher (Bearer token). REQUIRED — the endpoint refuses to run without it.
# Generate with: openssl rand -hex 32. Must match /etc/vibepost-cron.env on the VPS.
CRON_SECRET=""

# AES-256-GCM key for encrypting social tokens & AI API keys in the DB (32 random bytes, base64).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key = all stored tokens become unreadable. Back it up in a password manager.
ENCRYPTION_KEY=""

# Public base URL used to build media URLs
NEXT_PUBLIC_APP_URL="https://vibepost.online"

# Upload storage directory (mount a persistent volume here in Coolify)
UPLOAD_DIR="/app/uploads"
# Max upload size in MB (default 50)
UPLOAD_MAX_MB=50

# Comma-separated Workspace IDs whose published posts may appear on the public landing page.
# Empty = all workspaces are shown (legacy behaviour) — set this in production.
PUBLIC_SHOWCASE_WORKSPACE_IDS=""
